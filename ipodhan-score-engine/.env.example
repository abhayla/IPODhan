# IPO Scoring Engine - Environment Variables

# Database Configuration (Required) - Production VPS: Windows Server 2022 @ 103.118.16.189
DB_HOST=103.118.16.189
DB_PORT=5432
DB_NAME=ipodhan
DB_USER=postgres
DB_PASSWORD=***REMOVED-CREDENTIAL***
DB_POOL_MIN=1
DB_POOL_MAX=10

# Redis Cache (Required for performance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Scoring Configuration
ALGORITHM_VERSION=1.0
SCORE_CACHE_TTL=3600  # 1 hour in seconds

# Scheduling
SCORE_CALCULATION_TIMES=09:00,13:00,17:00  # IST times
TIMEZONE=Asia/Kolkata

# API Configuration
API_PORT=8001
API_HOST=0.0.0.0
API_KEY=your_secret_api_key  # For protected endpoints

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Environment
ENVIRONMENT=development  # development, staging, production

# Sentry Error Tracking (Optional)
SENTRY_DSN=
