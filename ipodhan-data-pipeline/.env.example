# Environment
ENVIRONMENT=development

# Database Configuration (Production VPS: Windows Server 2022 @ 103.118.16.189)
DB_HOST=103.118.16.189
DB_PORT=5432
DB_NAME=ipodhan
DB_USER=postgres
DB_PASSWORD=***REMOVED-CREDENTIAL***
