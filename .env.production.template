# ================================================================
# IPODhan Production Environment Configuration Template
# ================================================================
# Story: 8.4a - Production Deployment - Dev Machine Preparation
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Fill in all values marked with REQUIRED
# 3. Never commit .env.production to Git (already in .gitignore)
# 4. Verify all values before deployment
# ================================================================

# ================================================================
# APPLICATION CONFIGURATION
# ================================================================
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=IPODhan
NEXT_PUBLIC_APP_URL=https://ipodhan.com

# ================================================================
# DATABASE CONFIGURATION (PostgreSQL 16+)
# ================================================================
# REQUIRED: Production database credentials
DATABASE_HOST=103.118.16.189
DATABASE_PORT=5432
DATABASE_NAME=ipodhan
DATABASE_USER=postgres
DATABASE_PASSWORD=REQUIRED_CHANGE_ME

# Alternative: Full connection URL (use this OR individual settings above)
# DATABASE_URL=postgresql://postgres:PASSWORD@103.118.16.189:5432/ipodhan

# ================================================================
# REDIS CONFIGURATION (Redis 7.2+)
# ================================================================
# REQUIRED: Production Redis credentials
REDIS_HOST=103.118.16.189
REDIS_PORT=6379
REDIS_PASSWORD=REQUIRED_CHANGE_ME

# Alternative: Full connection URL (use this OR individual settings above)
# REDIS_URL=redis://:PASSWORD@103.118.16.189:6379

# ================================================================
# ANALYTICS & MONITORING
# ================================================================
# REQUIRED: Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=REQUIRED_CHANGE_ME

# OPTIONAL: Sentry DSN for error tracking
# Get from: https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=ipodhan

# ================================================================
# AFFILIATE LINKS
# ================================================================
# REQUIRED: Affiliate partner links
NEXT_PUBLIC_ZERODHA_AFFILIATE_LINK=https://signup.zerodha.com/?c=ZMPHZC
NEXT_PUBLIC_ANGELONE_AFFILIATE_LINK=https://tinyurl.com/2d98g2qe

# ================================================================
# SCRAPER CONFIGURATION
# ================================================================
# Data source URLs
NSE_URL=https://www.nseindia.com/market-data/public-issues
BSE_URL=https://www.bseindia.com/publicissue.html

# OPTIONAL: IPO Alerts API (Fallback data source)
# IPO_ALERTS_API_URL=https://api.ipoalerts.in
# IPO_ALERTS_API_KEY=your_api_key_here

# Scraper timeouts and retries
SCRAPER_TIMEOUT=30000
RETRY_ATTEMPTS=3
RETRY_DELAYS=1000,2000,4000

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=3600000

# Scheduler settings
SCRAPER_ENABLED=true
SCRAPER_INTERVAL_MODE=prod

# ================================================================
# LOGGING CONFIGURATION
# ================================================================
LOG_LEVEL=info

# ================================================================
# EMAIL SERVICE (Phase 2 - Not yet implemented)
# ================================================================
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=REQUIRED_CHANGE_ME
# EMAIL_FROM=noreply@ipodhan.com

# ================================================================
# SECURITY CONFIGURATION
# ================================================================
# OPTIONAL: Rate limiting for API routes
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW=900000

# ================================================================
# DEPLOYMENT NOTES
# ================================================================
# - Ensure PostgreSQL and Redis are running on the VPS
# - Verify firewall allows connections on ports 3000 (web), 5432 (postgres), 6379 (redis)
# - Use strong passwords for DATABASE_PASSWORD and REDIS_PASSWORD
# - Test all services with: curl http://localhost:3000/api/health
# - Monitor logs: pm2 logs ipodhan-web && pm2 logs ipodhan-scraper
# ================================================================
