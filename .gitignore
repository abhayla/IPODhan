# Claude Code config: track shared patterns, ignore local/runtime state.
# NOTE: gitignore does not support trailing comments on pattern lines, and a
# dir-level exclude (".claude/") blocks re-inclusion of children — use
# ".claude/*" with explicit negations instead.
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/rules/
!.claude/agents/
!.claude/hooks/
!.claude/config/
!.claude/settings.json
!.claude/synthesis-config.yml
!.claude/sync-manifest.json
!.claude/tasks/
.claude/tasks/*
!.claude/tasks/lessons.md
.claude/settings.local.json
.claude/.enhance-misses.log
.claude/.keepgoing-count
.claude/.overask-violations.log
CLAUDE.local.md
.playwright-mcp/
.ai/
web-bundles/

