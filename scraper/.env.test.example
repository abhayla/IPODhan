# Test-only environment for `npm run test:integration` in the scraper
# workspace (T-279). Copy this file to `.env.test` (gitignored -- see the
# repo root .gitignore) and point it at a throwaway/local Postgres + Redis
# instance, e.g. the same `postgres:16` / `redis:7.2-alpine` shape web's CI
# job uses.
#
# NEVER copy the values from `scraper/.env` into this file. That file is the
# LIVE runtime env -- its DATABASE_HOST/DATABASE_URL point at the production
# Postgres host (103.118.16.189). Running integration tests against those
# values writes real insert/delete/upsert rows into prod (GitHub #163).
#
# If this file (or a `.env.test` copy of it) is missing, no DB/Redis env
# vars resolve and the global integration-test guard
# (tests/helpers/db-safety-guard.ts, wired via vitest.integration.setup.ts)
# refuses to run any test -- fail closed, not fail open.

# Database - a throwaway/local Postgres instance, database name MUST contain
# "_test" (the guard rejects anything else, and rejects known prod/staging
# hosts outright regardless of the database name).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ipodhan_test
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ipodhan_test
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis - an UNAUTHENTICATED local/CI Redis instance. Prod/staging Redis for
# this project always requires a password; the guard treats any
# password/auth as a prod-shaped signal and refuses to run.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PASSWORD=
