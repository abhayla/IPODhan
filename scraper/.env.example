# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ipodhan

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# REDIS_DB=0 (explicit db index; wins over REDIS_URL's path suffix when both
#   are set. T-264 F2: staging MUST use a different db than prod, e.g. 1.)

# NSE Scraper
NSE_URL=https://www.nseindia.com/market-data/public-issues

# BSE Scraper
BSE_URL=https://www.bseindia.com/publicissue.html

# IPO Alerts API (Fallback)
IPO_ALERTS_API_URL=https://api.ipoalerts.in
IPO_ALERTS_API_KEY=your_api_key_here

# Scraper Configuration
SCRAPER_TIMEOUT=30000
RETRY_ATTEMPTS=3
RETRY_DELAYS=1000,2000,4000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=3600000

# Scheduler Configuration
# Enable/disable scheduler (default: true)
SCRAPER_ENABLED=true
# Interval mode: dev | prod (affects cron intervals)
SCRAPER_INTERVAL_MODE=prod

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Owner Alerting (T-194) - Notifier gateway (github.com/abhayla/Notifier).
# See .claude/rules/notifier-integration.md. Fail-open: unset = silent no-op,
# nothing changes for local/CI runs. The REAL key value is installed on the
# VPS .env at deploy time -- NEVER commit it here or anywhere in git.
NOTIFIER_URL=http://127.0.0.1:3300
NOTIFIER_KEY=
# Optional override; defaults to "ipodhan" (must match Notifier's
# projects.ipodhan key in config.yaml) if unset.
NOTIFIER_PROJECT=ipodhan

# Log Retention (Story 7.5)
LOG_RETENTION_DAYS=30

# ==================== DATA FLOW ARCHITECTURE - FEATURE FLAGS ====================
# Phase 1.8: Production Deployment - Data Consolidation Enabled (2025-11-07)
# ✅ Phase 1.7 Testing Complete: 91.1% test coverage, production-ready

# Enable field source tracking (tracks which scraper provided each field)
# ✅ PRODUCTION READY: Enable for full audit trail
ENABLE_SOURCE_TRACKING=true

# Enable conflict detection and logging
# ✅ PRODUCTION READY: Detects data inconsistencies across scrapers
ENABLE_CONFLICT_DETECTION=true

# Enable smart data consolidation with priority matrix (Phase 1)
# ✅ PRODUCTION READY: Intelligent multi-source data merging (ADMIN > DRHP > NSE > BSE)
ENABLE_DATA_CONSOLIDATION=true

# Match GMP/subscription rows to IPOs by normalized company name (#6/#8/#16 data-coverage).
# ✅ PRODUCTION READY (T-243 required-key ratchet — see assert-env-keys.sh SCRAPER_REQUIRED_KEYS)
ENABLE_GMP_NAME_MATCH=true

# Persist Moneycontrol subscription percentages.
# ✅ PRODUCTION READY — without this, subscriptions rows stop being written even though the
# MONEYCONTROL scraper still reports SUCCESS (the exact T-251/F9 failure mode: this flag was
# never carried from the Windows deploy to the Linux env at the T-249 cutover and subscription
# writes went silent for ~70min on a closing day).
ENABLE_MONEYCONTROL_SUBSCRIPTION=true

# Switch the BSE orchestrator to scrapeBSEViaAPI (JSON API; IR_flag is the authoritative
# "is this really an IPO" signal). Without it, BSE falls back to the HTML scraper and
# corporate-action rows (buybacks/rights/open-offers) get re-admitted as fake IPOs — see
# ipo-duplicate-detection.md and the T-251/F1 cleanup this flag being off caused.
# ✅ PRODUCTION READY (PR #26)
ENABLE_BSE_API=true

# Primary-source document discovery (NSE/BSE/SEBI RHP+anchor, incl. SME) — PR #59.
# 🔒 OWNER LOCK: stays false. This flag WAS true on the Windows deploy
# (ecosystem.config.js:66) but the owner's migration-plan v4 explicitly keeps it OFF on
# Linux (owner-approved plan header) — do not flip this to true without an explicit
# owner sign-off, even though "carrying every Windows flag forward" would suggest true.
ENABLE_PRIMARY_SOURCE_DISCOVERY=false

# Enable early IPO detection via SEBI monitoring (Phase 3)
# ⏳ FUTURE: Not yet implemented
ENABLE_EARLY_DETECTION=false

# ==================== GRADUAL ROLLOUT CONTROLS ====================
# Percentage of IPOs to enable features for (0-100)
# Phase 1.8: 100% rollout (full production deployment)

SOURCE_TRACKING_PERCENTAGE=100
CONFLICT_DETECTION_PERCENTAGE=100
CONSOLIDATION_PERCENTAGE=100

# ==================== TESTING & DEBUG ====================

# Verbose logging for data flow operations
# 💡 Set to true for detailed consolidation debugging
DEBUG_DATA_FLOW=false

# Specific scrapers to enable (comma-separated: NSE,BSE,MONEYCONTROL,CHITTORGARH)
# Leave empty to enable for all scrapers
ENABLED_SCRAPERS=

# Specific IPO IDs to enable (comma-separated) - for targeted testing
ENABLED_IPO_IDS=

# ==================== PERFORMANCE TUNING ====================

# Maximum conflict logs per IPO per run
MAX_CONFLICTS_PER_IPO=50

# Batch size for bulk source tracking
SOURCE_TRACKING_BATCH_SIZE=100
