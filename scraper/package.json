{
  "name": "scraper",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "test": "vitest",
    "test:unit": "vitest --config vitest.config.ts",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "puppeteer": "^22.0.0",
    "zod": "^3.22.0",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "dotenv": "^16.4.0",
    "ioredis": "5.8.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "tsc-alias": "^1.8.8",
    "drizzle-orm": "^0.30.0"
  }
}
