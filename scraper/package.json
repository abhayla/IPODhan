{
  "name": "scraper",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx --tsconfig tsx.tsconfig.json src/index.ts",
    "start:bse": "tsx --tsconfig tsx.tsconfig.json src/index.ts --source=bse",
    "start:moneycontrol": "tsx --tsconfig tsx.tsconfig.json src/index.ts --source=moneycontrol",
    "start:chittorgarh": "tsx --tsconfig tsx.tsconfig.json src/index.ts --source=chittorgarh",
    "start:gmp": "tsx --tsconfig tsx.tsconfig.json src/index.ts --source=gmp",
    "start:fallback": "tsx --tsconfig tsx.tsconfig.json src/index.ts --source=fallback",
    "start:api": "tsx --tsconfig tsx.tsconfig.json src/index.ts --source=api",
    "start:all": "tsx --tsconfig tsx.tsconfig.json src/index.ts --source=all",
    "dev": "tsx watch src/index.ts",
    "scheduler": "tsx src/scheduler/index.ts",
    "scheduler:dev": "tsx watch src/scheduler/index.ts",
    "scheduler:test": "NODE_ENV=test SCRAPER_INTERVAL_MODE=dev tsx src/scheduler/index.ts",
    "backfill": "tsx src/scripts/backfill-historical-ipos.ts",
    "backfill:dry": "tsx src/scripts/backfill-historical-ipos.ts --dry-run",
    "backfill-lot-size": "tsx scripts/backfill-lot-size-from-chittorgarh.ts",
    "backfill-lot-size:execute": "tsx scripts/backfill-lot-size-from-chittorgarh.ts --execute",
    "backfill-lot-size:test": "tsx scripts/backfill-lot-size-from-chittorgarh.ts --limit 5",
    "validate:backfill": "tsx src/scripts/validate-backfill.ts",
    "update:listing-performance": "tsx src/scrapers/listing-performance-updater.ts",
    "backfill:stuck-listing": "tsx src/scripts/backfill-stuck-listing.ts",
    "backfill:stuck-listing:execute": "tsx src/scripts/backfill-stuck-listing.ts --execute",
    "build": "tsc && tsc-alias",
    "test": "vitest",
    "test:unit": "vitest --config vitest.config.ts",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "test:load": "vitest --run --config vitest.load.config.ts",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@ipodhan/shared": "*",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.2",
    "axios": "^1.13.1",
    "cheerio": "^1.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^9.5.0",
    "dotenv": "^16.4.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "pdf-parse": "^2.4.5",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "puppeteer": "^22.0.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "cli-table3": "^0.6.5",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^3.15.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  }
}
