# IPODhan Data Pipeline - Systemd Service File
# Location: /etc/systemd/system/ipodhan-pipeline.service
#
# Installation:
#   sudo cp ipodhan-pipeline.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable ipodhan-pipeline
#   sudo systemctl start ipodhan-pipeline
#
# Management:
#   sudo systemctl status ipodhan-pipeline
#   sudo systemctl restart ipodhan-pipeline
#   sudo journalctl -u ipodhan-pipeline -f

[Unit]
Description=IPODhan Data Pipeline Service
Documentation=file:///opt/ipodhan/ipodhan-data-pipeline/README.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple

# User and Group (change as needed)
User=www-data
Group=www-data

# Working directory
WorkingDirectory=/opt/ipodhan/ipodhan-data-pipeline

# Environment
Environment="PATH=/opt/ipodhan/ipodhan-data-pipeline/venv/bin"
Environment="PYTHONUNBUFFERED=1"

# Command to execute
ExecStart=/opt/ipodhan/ipodhan-data-pipeline/venv/bin/python main.py schedule

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipodhan-pipeline

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (optional)
# MemoryLimit=1G
# CPUQuota=50%

[Install]
WantedBy=multi-user.target
