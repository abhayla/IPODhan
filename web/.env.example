# ==================== Monitoring & Analytics ====================

# Google Analytics 4 Configuration
# Get your Measurement ID from https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Tracking (Optional)
# Create account at https://sentry.io
# Free tier: 5,000 events/month
# Server/edge read SENTRY_DSN first, falling back to NEXT_PUBLIC_SENTRY_DSN.
# The browser needs the NEXT_PUBLIC_ one specifically (it is inlined into the
# client bundle). With neither set, Sentry never initialises — no network calls.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG and SENTRY_PROJECT are read by withSentryConfig in next.config.mjs;
# without them (and SENTRY_AUTH_TOKEN) source-map upload silently no-ops, so
# production stack traces stay minified.
# SENTRY_ORG=your_org_slug
# SENTRY_PROJECT=your_project_slug
# SENTRY_AUTH_TOKEN=your_auth_token_here

# Logging Configuration
# LOG_LEVEL options: debug, info, warn, error, fatal
# Default: info in production, debug in development
LOG_LEVEL=info

# ==================== Database Configuration ====================

# Database Configuration
DATABASE_HOST=your_host
DATABASE_PORT=5432
DATABASE_NAME=ipodhan
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=IPODhan

# Optional: Specify custom port and URLs (auto-detected if not set)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=/api (for client-side) or full URL (for server-side)

# Affiliate Links
NEXT_PUBLIC_ZERODHA_AFFILIATE_LINK=https://signup.zerodha.com/?c=ZMPHZC
NEXT_PUBLIC_ANGELONE_AFFILIATE_LINK=https://tinyurl.com/2d98g2qe

# ==================== Security ====================

# Admin API Authentication Token
# REQUIRED for accessing admin endpoints (/api/admin/*, /api/db-test)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters recommended for security
# Use with header: Authorization: Bearer <token>
ADMIN_API_TOKEN=your_64_character_hexadecimal_token_here_please_generate_new_one

# ==================== Admin Panel (Phase 6) ====================

# Enable Manual Data Management System
# Set to 'true' to enable admin panel and field protection features
# Default: false (disabled for security)
ADMIN_PANEL_ENABLED=false

# Admin Authentication Token for Manual Data Management
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use with header: Authorization: Bearer <token>
# Note: Different from ADMIN_API_TOKEN above (legacy)
ADMIN_AUTH_TOKEN=your_64_character_hexadecimal_token_here_please_generate_new_one

# ==================== Redis Configuration ====================

# Redis connection for caching
# Required for production, optional for development
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password (if authentication enabled)
# REDIS_URL=redis://127.0.0.1:6379 (alternative to individual params)

# ==================== Production Alerts (Phase 3.4) ====================

# Email Alerts (CRITICAL conflicts, duplicates)
# SMTP configuration for sending email alerts
# Provider options: Gmail, SendGrid, AWS SES, or custom SMTP
#
# Gmail Setup:
# 1. Enable 2-factor authentication
# 2. Generate app-specific password at: https://myaccount.google.com/apppasswords
# 3. Use app password (not your regular Gmail password)
#
# SendGrid Setup (Recommended for Production):
# 1. Create free account at: https://sendgrid.com (100 emails/day free)
# 2. Create API key in Settings > API Keys
# 3. Set SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASSWORD=<your-api-key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=alerts@ipodhan.com
ADMIN_EMAIL=admin@yourcompany.com

# Slack Alerts (DRHP failures, performance degradation)
# Slack Incoming Webhook URL for operational alerts
# Setup: https://api.slack.com/messaging/webhooks
# 1. Go to https://api.slack.com/messaging/webhooks
# 2. Click "Create New Webhook"
# 3. Select channel (e.g., #dev-alerts or #production-alerts)
# 4. Copy webhook URL and paste below
# Format: https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# PagerDuty Alerts (Optional - CRITICAL system failures)
# For 24/7 on-call alerting (duplicate IPOs, system health)
# Setup: https://www.pagerduty.com/
# 1. Create integration in PagerDuty
# 2. Copy Integration Key
# Not required for initial deployment - can add post-launch
# PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key_here

# Alert Thresholds (Optional - Override Defaults)
# ALERT_CRITICAL_CONFLICTS_THRESHOLD=10
# ALERT_DRHP_FAILURES_THRESHOLD=5
# ALERT_CONFLICT_RATE_THRESHOLD=5.0
# ALERT_SLOW_CONSOLIDATION_THRESHOLD=1000
