generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  name            String
  phone           String?
  isVerified      Boolean   @default(false)
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  portfolios      Portfolio[]
  alerts          Alert[]
  applications    IPOApplication[]
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

// IPO Model
model IPO {
  id              String    @id @default(uuid())
  companyName     String
  symbol          String?
  exchange        Exchange
  category        String
  issueSize       Float?
  priceRangeLow   Float
  priceRangeHigh  Float
  lotSize         Int
  minInvestment   Float
  openDate        DateTime
  closeDate       DateTime
  allotmentDate   DateTime?
  listingDate     DateTime?
  status          IPOStatus @default(UPCOMING)
  registrar       String?
  leadManager     String?

  // Subscription Data
  subscription    Float?
  retailSub       Float?
  qibSub          Float?
  niiSub          Float?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  gmpHistory      GMP[]
  applications    IPOApplication[]
  performance     IPOPerformance?
}

enum Exchange {
  NSE
  BSE
  BOTH
}

enum IPOStatus {
  UPCOMING
  LIVE
  CLOSED
  LISTED
  WITHDRAWN
}

// Grey Market Premium Model
model GMP {
  id              String    @id @default(uuid())
  ipoId           String
  ipo             IPO       @relation(fields: [ipoId], references: [id])
  premium         Float
  premiumPercent  Float
  expectedListing Float
  recordedAt      DateTime  @default(now())
  source          String?
}

// IPO Performance Model
model IPOPerformance {
  id              String    @id @default(uuid())
  ipoId           String    @unique
  ipo             IPO       @relation(fields: [ipoId], references: [id])
  listingPrice    Float
  listingGain     Float
  listingGainPct  Float
  currentPrice    Float
  weekHigh        Float?
  weekLow         Float?
  monthReturn     Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// User Portfolio Model
model Portfolio {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  ipoName         String
  quantity        Int
  allotmentPrice  Float
  listingPrice    Float?
  currentPrice    Float?
  status          PortfolioStatus
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum PortfolioStatus {
  APPLIED
  ALLOTTED
  NOT_ALLOTTED
  LISTED
  SOLD
}

// IPO Application Model
model IPOApplication {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  ipoId           String
  ipo             IPO       @relation(fields: [ipoId], references: [id])
  quantity        Int
  bidPrice        Float
  broker          String
  applicationNo   String?
  status          ApplicationStatus
  appliedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum ApplicationStatus {
  PENDING
  SUBMITTED
  ALLOTTED
  NOT_ALLOTTED
  CANCELLED
}

// Alert Model
model Alert {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  type            AlertType
  ipoName         String?
  condition       String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

enum AlertType {
  IPO_OPENING
  IPO_CLOSING
  GMP_CHANGE
  ALLOTMENT_STATUS
  LISTING_DAY
  PRICE_TARGET
}

// Broker Model
model Broker {
  id              String    @id @default(uuid())
  name            String    @unique
  logo            String?
  accountOpeningFee Float?
  maintenanceCharge Float?
  brokerageEquity Float?
  brokerageOptions Float?
  features        String[]
  pros            String[]
  cons            String[]
  rating          Float?
  website         String?
  supportEmail    String?
  supportPhone    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}